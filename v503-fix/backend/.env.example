# =============================================================================
# Memecoin AI Bot - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
# SQLite for dev / PostgreSQL for prod
DATABASE_URL=sqlite+aiosqlite:///./data/memecoin_bot.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/memecoin_bot

# --- Redis (optional, falls back to in-memory cache) ---
REDIS_URL=redis://redis:6379/0
USE_REDIS=false

# --- Paper Trading ---
PAPER_CAPITAL_USD=10000
PAPER_DEFAULT_POSITION_PCT=5
PAPER_MAX_OPEN_POSITIONS=10
PAPER_FEE_PCT=0.25
PAPER_SLIPPAGE_PCT=0.5

# --- Risk Management ---
RISK_DAILY_LOSS_LIMIT_PCT=5
RISK_WEEKLY_LOSS_LIMIT_PCT=10
RISK_MAX_DRAWDOWN_PCT=20
RISK_COOLDOWN_AFTER_LOSSES=3
RISK_MAX_RISK_PER_TRADE_PCT=2

# --- Qualification Thresholds ---
MIN_WIN_PROBABILITY=0.70
MIN_CONFIDENCE_INTERVAL=0.70
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_24H_USD=100000
MIN_DATA_AGE_SECONDS=120
MAX_RISK_SCORE=70

# --- Market Scanner ---
SCAN_INTERVAL_SECONDS=60
SCAN_MAX_TOKENS=200
SCAN_NETWORKS=solana
# Comma-separated: solana,base,ethereum,bsc

# --- Data Sources (free APIs) ---
DEXSCREENER_API_URL=https://api.dexscreener.com
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_BACKUP_1=https://rpc.ankr.com/solana
SOLANA_RPC_BACKUP_2=https://solana-rpc.publicnode.com

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ML ---
ML_MODEL_DIR=./data/models
ML_RETRAIN_INTERVAL_HOURS=24
ML_MIN_TRAIN_SAMPLES=200
ML_CALIBRATION_METHOD=isotonic

# --- On-chain ---
ONCHAIN_TOP_HOLDERS=20
ONCHAIN_MIN_HOLDER_BALANCE_PCT=1.0

# --- Sentiment (placeholders - require own API keys) ---
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Trading Mode ---
# CRITICAL: Controls whether the bot executes REAL trades or only paper trades.
# paper   = simulation only (safe)
# live    = REAL money trades via Binance API (dangerous - requires explicit setup)
TRADING_MODE=paper

# --- Binance API (for live trading) ---
# Get these from https://www.binance.com/en/my/settings/api-management
# WARNING: Enable only "Spot Trading" permission, NOT "Withdrawals"
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# Max single trade size (USD) - safety cap
BINANCE_MAX_TRADE_USD=500
# Daily trade cap (USD)
BINANCE_DAILY_CAP_USD=2000

# --- RedotPay (crypto card - limited API support) ---
# RedotPay does not currently expose a public trading API.
# We provide integration hooks + balance tracking (when API becomes available).
# For now: manual transfer reminders + balance placeholder.
REDOTPAY_API_TOKEN=
REDOTPAY_ACCOUNT_EMAIL=
# Auto-transfer threshold: when balance exceeds this, remind user to withdraw
REDOTPAY_AUTO_REMINDER_THRESHOLD_USD=1000

# --- Backtesting ---
BACKTEST_FEE_PCT=0.25
BACKTEST_SLIPPAGE_PCT=0.5
BACKTEST_LOOKBACK_DAYS=90

# --- AI Agents (using Z.ai SDK - free) ---
AI_AGENT_MODEL=glm-4-flash
AI_AGENT_TEMPERATURE=0.3
AI_AGENT_MAX_TOKENS=800
AI_AGENT_TIMEOUT_SECONDS=30
# Disable all 5 agents (set to false to enable each)
AI_AGENT_TECHNICAL_ENABLED=true
AI_AGENT_SECURITY_ENABLED=true
AI_AGENT_LIQUIDITY_ENABLED=true
AI_AGENT_SENTIMENT_ENABLED=true
AI_AGENT_RISK_ENABLED=true
# Require ALL agents to agree (consensus rule)
AI_AGENT_REQUIRE_UNANIMITY=true
